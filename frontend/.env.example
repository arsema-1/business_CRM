VITE_API_URL=http://localhost:4000

# reCAPTCHA v3 site key — leave blank to skip CAPTCHA in development.
# Must be paired with RECAPTCHA_SECRET_KEY on the backend.
# VITE_RECAPTCHA_SITE_KEY="your-site-key"

# Optional: show a hint on the login page (e.g. for local dev/demo environments).
# Leave unset or empty in production to hide the hint entirely.
# VITE_DEMO_HINT="Demo: admin@demo.com / warehouse@demo.com / sales@demo.com / accounts@demo.com"
