generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTS
}

enum RoleChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum MovementType {
  IN
  OUT
}

enum ChallanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 Role
  isActive             Boolean   @default(true)
  emailVerifiedAt      DateTime?
  verificationToken    String?   @unique
  // Self-registered accounts need an admin to approve them before they can
  // touch business data. Admin-created accounts skip this gate.
  selfRegistered       Boolean   @default(false)
  approvedAt           DateTime?
  approvedById         String?
  // Temporary lockout after repeated failed password attempts
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  passwordResetToken   String?   @unique
  passwordResetExpiry  DateTime?
  // ── Multi-factor authentication (task 1.5) ──────────────────────────────
  // `totpSecret` is AES-256-GCM encrypted: a database dump alone cannot mint
  // valid codes. A pending secret is kept apart until a live code proves the
  // user really enrolled the authenticator.
  mfaEnabled           Boolean   @default(false)
  totpSecret           String?
  pendingTotpSecret    String?
  pendingTotpAt        DateTime?
  mfaEnabledAt         DateTime?
  // Single-use, hashed token for the "lost my authenticator" email recovery
  mfaRecoveryHash      String?   @unique
  mfaRecoveryExpiry    DateTime?
  lastReviewedAt       DateTime?
  reviewDueAt          DateTime?
  createdAt            DateTime  @default(now())

  customersCreated     Customer[]          @relation("CustomerCreatedBy")
  followUps            FollowUp[]
  stockMovements       StockMovement[]
  challans             Challan[]
  roleChangeRequests   RoleChangeRequest[] @relation("RCRRequestedFor")
  roleChangeRequested  RoleChangeRequest[] @relation("RCRRequestedBy")
  roleChangeReviewed   RoleChangeRequest[] @relation("RCRReviewedBy")
  webAuthnCredentials  WebAuthnCredential[]
  sessions             Session[]
  mfaBackupCodes       MfaBackupCode[]
  mfaChallenges        MfaChallenge[]
}

// A half-finished sign-in: the password was correct, but the second factor has
// not been presented yet. Nothing is usable until the row is consumed, it can
// only be attempted a handful of times, and it dies on its own.
model MfaChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Recovery codes are stored as HMAC-SHA256 hashes and can be used exactly once.
model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per signed-in session. Tokens are never stored in plaintext: only
// SHA-256 hashes are kept, so a database leak cannot be replayed as a login.
// Deleting or revoking the row immediately invalidates both the access token
// (which carries this session id) and the refresh token.
model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Current refresh token hash, plus the hash it was rotated from so replaying
  // an already-used refresh token can be detected and the session killed.
  refreshTokenHash  String    @unique
  previousTokenHash String?
  // Hash of the double-submit CSRF token handed to the browser
  csrfTokenHash     String
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  // Hard deadline (absolute session timeout) and the moving idle deadline
  expiresAt         DateTime
  idleExpiresAt     DateTime
  revokedAt         DateTime?
  revokedReason     String?

  @@index([userId])
  @@index([expiresAt])
  @@index([previousTokenHash])
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String   // base64url-encoded COSE key
  counter      BigInt   @default(0)
  deviceName   String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Customer {
  id           String         @id @default(uuid())
  name         String         @db.VarChar(255)
  mobile       String         @db.VarChar(20)
  email        String?        @db.VarChar(255)
  businessName String?        @db.VarChar(255)
  gstNumber    String?        @db.VarChar(20)
  customerType CustomerType   @default(RETAIL)
  address      String?        @db.VarChar(500)
  status       CustomerStatus @default(LEAD)
  followUpDate DateTime?
  notes        String?        @db.VarChar(2000)
  createdById  String?
  createdBy    User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  followUps FollowUp[]
  challans  Challan[]

  @@index([name])
  @@index([mobile])
  @@index([status])
}

model FollowUp {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String   @db.VarChar(2000)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  category      String?
  unitPrice     Decimal  @db.Decimal(12, 2)
  currentStock  Int      @default(0)
  minStockAlert Int      @default(0)
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockMovements StockMovement[]
  challanItems   ChallanItem[]

  @@index([sku])
  @@index([name])
}

model StockMovement {
  id              String       @id @default(uuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  quantityChanged Int
  movementType    MovementType
  reason          String
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())
}

model Challan {
  id            String        @id @default(uuid())
  challanNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  totalQuantity Int           @default(0)
  status        ChallanStatus @default(DRAFT)
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items ChallanItem[]
}

model ChallanItem {
  id                  String  @id @default(uuid())
  challanId           String
  challan             Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  productSkuSnapshot  String
  unitPriceSnapshot   Decimal @db.Decimal(12, 2)
  quantity            Int
}

// Append-only trail of security-relevant activity (task 2.1) and critical
// system events (task 2.2). Carry no foreign key on purpose: deleting a user
// must never erase what that user did.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  // Role at the time of the action, so a later promotion cannot rewrite history
  userRole  String?
  action    String
  entity    String?
  entityId  String?
  detail    String?
  ipAddress String?
  userAgent String?
  method    String?
  path      String?
  // INFO | WARN | CRITICAL
  severity  String   @default("INFO")
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  // Tamper-evident chain: a monotonic sequence plus an HMAC over this row and
  // its predecessor. A database trigger makes the table append-only.
  seq      Int     @unique @default(autoincrement())
  prevHash String?
  hash     String?

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
  @@index([userEmail])
}

// One row per routed security alert (task 2.5). Raised by the detection rules
// in utils/alerting.ts, acknowledged by an administrator, and escalated to the
// secondary contacts when it stays open past ALERT_ESCALATION_MINUTES.
model SecurityAlert {
  id                  String    @id @default(uuid())
  alertType           String
  // MEDIUM | HIGH | CRITICAL
  severity            String
  // SECURITY | OPERATIONS | DATA
  team                String
  title               String
  detail              String    @db.VarChar(2000)
  // Same condition inside the cooldown window bumps this alert instead of
  // creating (and paging for) a duplicate.
  dedupKey            String
  occurrences         Int       @default(1)
  source              String?
  sourceEventId       String?
  acknowledgedAt      DateTime?
  acknowledgedById    String?
  acknowledgedByEmail String?
  escalatedAt         DateTime?
  notifiedAt          DateTime?
  notificationError   String?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@index([dedupKey])
  @@index([createdAt])
  @@index([acknowledgedAt])
  @@index([severity])
  @@index([team])
}

model RoleChangeRequest {
  id              String           @id @default(uuid())
  targetUserId    String
  targetUser      User             @relation("RCRRequestedFor", fields: [targetUserId], references: [id])
  requestedById   String
  requestedBy     User             @relation("RCRRequestedBy", fields: [requestedById], references: [id])
  fromRole        Role
  toRole          Role
  justification   String           @db.VarChar(1000)
  status          RoleChangeStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?            @relation("RCRReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())

  @@index([targetUserId])
  @@index([status])
  @@index([createdAt])
}
