# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public"

# JWT — signs the short-lived access token. Changing it signs everyone out.
JWT_SECRET="change-this-to-a-long-random-string"

# Session policy (task 1.4)
# Access tokens live in an HttpOnly cookie and expire quickly; the refresh token
# is rotated on every use. A session ends after SESSION_IDLE_MINUTES without
# activity, and never lasts longer than SESSION_TTL_HOURS.
ACCESS_TOKEN_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_TTL_HOURS=12
# Cookies are Secure automatically in production. Set COOKIE_SECURE="false" only
# for plain-HTTP development on a non-localhost host.
COOKIE_SECURE="false"
# strict (default) suits same-site frontend/API. Use "none" (forces Secure) when
# the SPA is served from a different site, or "lax" as a fallback.
COOKIE_SAME_SITE="strict"
# Set to a shared parent domain (e.g. .example.com) when the SPA needs to read
# the CSRF cookie cross-subdomain.
# COOKIE_DOMAIN=".example.com"

# Multi-factor authentication (task 1.5)
# Name shown in the authenticator app next to the account.
MFA_ISSUER="Mini ERP CRM"
# AES-256-GCM key for TOTP secrets stored in the database. Set a long random
# value in production; it falls back to JWT_SECRET when unset.
# MFA_ENCRYPTION_KEY="another-long-random-string"
# How long the "password accepted, code still needed" step stays valid.
MFA_CHALLENGE_MINUTES=5
# Wrong codes allowed per sign-in before the challenge is burned.
MFA_MAX_ATTEMPTS=5
# Number of one-time backup codes issued on enrollment.
MFA_BACKUP_CODES=10

# Audit log protection
# AES-256-GCM encryption for audit details/IPs and the HMAC that chains the
# trail. Keep it stable — rotating it makes existing entries unreadable and
# unverifiable. Falls back to JWT_SECRET when unset (development only).
# LOG_ENCRYPTION_KEY="another-long-random-string"

# Server
PORT=4000

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"

# Seed user passwords (used only by src/seed.ts)
SEED_PASSWORD="Password@123"

# Breached-password checks use the Have I Been Pwned k-anonymity API and fail
# open if it is unreachable. No secret/key required.

# Frontend URL (used in email links and WebAuthn origin)
APP_URL="http://localhost:5173"

# WebAuthn Relying Party (must match the hostname users visit)
RP_NAME="Mini ERP CRM"
RP_ID="localhost"

# SMTP — leave blank to skip sending emails (links printed to console instead)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="arsemaarse51@gmail.com"
# Gmail requires an App Password (Google account → Security → 2-Step Verification
# → App passwords). A normal account password will be rejected.
SMTP_PASS="your-16-char-app-password"
# Defaults to SMTP_USER when unset
SMTP_FROM="arsemaarse51@gmail.com"

# reCAPTCHA v3 — leave blank to skip verification in development
# Get keys at https://www.google.com/recaptcha/admin
# RECAPTCHA_SECRET_KEY="your-secret-key"
# RECAPTCHA_THRESHOLD=0.5

# Role granted to self-registered accounts. One of SALES, WAREHOUSE, ACCOUNTS
# (ADMIN is never allowed). Users stay inactive until they verify their email.
DEFAULT_SIGNUP_ROLE="SALES"

# Account lockout after repeated failed sign-ins
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Force HTTPS redirects on non-production hosts (production always enforces it)
# FORCE_HTTPS="true"

# ── Centralized logging and retention (task 2.4) ─────────────────────────────
# Structured JSON logs go to stdout always. Set LOG_TO_FILE=true to also keep
# daily app-YYYY-MM-DD.log files locally (private 0700/0600 permissions).
LOG_LEVEL="info"
LOG_TO_FILE="false"
# LOG_DIR="./logs"
# Central collector (SIEM): any HTTP JSON ingest endpoint — Vector, Fluent Bit,
# Logstash HTTP input, a Splunk HEC adapter or your own ingest function.
# Leave empty to disable shipping. Records are batched, retried, and dropped
# oldest-first if the collector stays down; requests never wait for it.
# SIEM_URL="https://siem.example.com/ingest/logs"
# Raw Authorization header value, e.g. "Splunk <token>" or "Bearer <token>"
# SIEM_AUTH_HEADER="Bearer change-me"
SIEM_SOURCE="mini-erp-crm"
SIEM_BATCH_SIZE=50
SIEM_FLUSH_SECONDS=5
SIEM_MAX_BUFFER=1000
SIEM_TIMEOUT_MS=5000
# Retention (days). App log files are deleted automatically; the audit trail is
# append-only and is NEVER deleted by the sweep — past its window it needs an
# encrypted archival copy (see docs/logging-and-monitoring.md).
APP_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
SIEM_RETENTION_DAYS=90
RETENTION_SWEEP_HOURS=24

# ── Security alerting and escalation (task 2.5) ──────────────────────────────
# Alerts are persisted in the SecurityAlert table, shown on /monitoring, and
# routed to the responsible team. Configure at least one route (team emails or
# the webhook); without one, alerts are still recorded but nobody is paged.
ALERTING_ENABLED=true
# Generic JSON webhook: Slack/Teams incoming webhook relay, PagerDuty events
# adapter, or an internal on-call bridge. Leave empty to disable webhook delivery.
# ALERT_WEBHOOK_URL="https://hooks.example.com/security"
# ALERT_WEBHOOK_AUTH_HEADER="Bearer change-me"
ALERT_WEBHOOK_TIMEOUT_MS=5000

# Team routes (comma-separated addresses).
# ALERT_SECURITY_EMAILS="security@example.com,oncall@example.com"
# ALERT_OPERATIONS_EMAILS="ops@example.com"
# ALERT_DATA_EMAILS="data-owners@example.com"
# Second-tier contacts for HIGH/CRITICAL alerts that stay unacknowledged.
# Defaults to the security team when empty.
# ALERT_ESCALATION_EMAILS="security-lead@example.com,cto@example.com"
ALERT_ESCALATION_MINUTES=15
ALERT_ESCALATION_SWEEP_SECONDS=60
# Runbook/dashboard link included in every notification.
# ALERT_RUNBOOK_URL="https://wiki.example.com/runbooks/security-alerts"

# Detection thresholds. Bursts are counted from the append-only audit trail.
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_FAILED_LOGIN_WINDOW_MINUTES=15
ALERT_AUTHZ_DENIAL_THRESHOLD=10
ALERT_AUTHZ_DENIAL_WINDOW_MINUTES=10
ALERT_CSRF_THRESHOLD=10
ALERT_CSRF_WINDOW_MINUTES=10
ALERT_DATA_ACCESS_THRESHOLD=20
ALERT_DATA_ACCESS_WINDOW_MINUTES=10
# Repeated instances of the same condition inside this window update the open
# alert instead of paging the team again.
ALERT_COOLDOWN_MINUTES=30
